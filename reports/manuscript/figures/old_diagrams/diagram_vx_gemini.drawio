        <mxCell id="n_o3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#004085;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="250" y="189" width="12" height="12" as="geometry" /></mxCell>
