          <mxGeometry x="1372" y="404" width="22" height="14" as="geometry" />
        </mxCell>
        <mxCell id="lhard_vlbl" value="q&lt;sub&gt;hard&lt;/sub&gt; ≈ one-hot on k* = 2" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="402" width="120" height="16" as="geometry" />
