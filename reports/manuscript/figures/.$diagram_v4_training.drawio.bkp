        <mxCell id="off_title" value="🛠  &lt;b&gt;Phase 1 — Offline Training&lt;/b&gt;     &lt;span style=&quot;font-style:italic;color:#404040;font-size:11px;&quot;&gt;dataset-level, one-time per training run&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1">
