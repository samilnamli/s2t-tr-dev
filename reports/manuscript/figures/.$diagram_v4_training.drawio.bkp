        <mxCell id="rw_arrow" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="router" target="wn_panel"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- =============== LOSS DESIGN BLOCK =================== -->
        <mxCell id="loss_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#5B2C6F;strokeWidth=1.5;" vertex="1" parent="1">
