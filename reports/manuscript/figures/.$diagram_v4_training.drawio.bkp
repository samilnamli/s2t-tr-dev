        <!-- Router (online uses TRAINED router) -->
        <mxCell id="on_router" value="&lt;b&gt;trained router&lt;/b&gt;&lt;br&gt;g&lt;sub&gt;θ&lt;/sub&gt;&lt;sup&gt;⋆&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Times New Roman;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
