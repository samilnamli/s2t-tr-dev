        <mxCell id="lsoft_v3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#5B2C6F;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1372" y="532" width="22" height="12" as="geometry" />
        </mxCell>
        <mxCell id="lsoft_vlbl" value="q&lt;sub&gt;soft&lt;/sub&gt; sharper around k* but non-zero elsewhere" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="532" width="120" height="16" as="geometry" />
        </mxCell>

        <!-- Total loss -->
        <mxCell id="ltot_box" value="&lt;b&gt;ℒ&lt;/b&gt; = λ&lt;sub&gt;wer&lt;/sub&gt; ℒ&lt;sub&gt;wer&lt;/sub&gt; + λ&lt;sub&gt;hard&lt;/sub&gt; ℒ&lt;sub&gt;hard&lt;/sub&gt; + λ&lt;sub&gt;soft&lt;/sub&gt; ℒ&lt;sub&gt;soft&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B2C6F;strokeColor=#5B2C6F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1190" y="580" width="430" height="40" as="geometry" />
