        <!-- argmax -> j -->
        <mxCell id="on_argmax" value="argmax → &lt;b&gt;j = 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
