        <!-- L_soft -->
        <mxCell id="lsoft_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5B2C6F;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1190" y="440" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lsoft_h" value="&lt;b&gt;ℒ&lt;sub&gt;soft&lt;/sub&gt;&lt;/b&gt; — temperature-soft cross-entropy" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;fontColor=#4A235A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="444" width="410" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lsoft_eq" value="q&lt;sub&gt;soft&lt;/sub&gt; = softmax( −W&lt;sub&gt;n&lt;/sub&gt; / τ )  &amp;nbsp;&amp;nbsp;⟹&amp;nbsp;&amp;nbsp;  ℒ&lt;sub&gt;soft&lt;/sub&gt; = CE(w&lt;sub&gt;n&lt;/sub&gt;, q&lt;sub&gt;soft&lt;/sub&gt;)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1200" y="468" width="410" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lsoft_pro" value="✓ keeps strong gradient AND preserves WER-magnitude information" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontColor=#1E6E2A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="494" width="410" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lsoft_con" value="↻ τ controls sharpness:  τ→0 ≈ ℒ&lt;sub&gt;hard&lt;/sub&gt; · τ→∞ ≈ uniform" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontStyle=2;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="1200" y="512" width="410" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lsoft_v1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#5B2C6F;strokeWidth=1;" vertex="1" parent="1">
