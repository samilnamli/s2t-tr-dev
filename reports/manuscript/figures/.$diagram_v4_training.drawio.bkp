        <!-- decoder lanes: only the chosen one runs ============- -->
        <!-- Lane 1: ghosted -->
        <mxCell id="on_d1" value="A&lt;sub&gt;1&lt;/sub&gt; decoder + LM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.2;dashed=1;fontFamily=Times New Roman;fontSize=11;fontColor=#A6A6A6;" vertex="1" parent="1">
