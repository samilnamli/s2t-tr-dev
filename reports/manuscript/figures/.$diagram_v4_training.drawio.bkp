        <!-- =================================================== -->
        <!-- DESIGN NOTES                                          -->
        <!--   Centerpiece: the per-clip WER vector W_n and the    -->
        <!--   three composite-loss "lenses" that read it.         -->
        <!--   Architecture is a single compact box (cross-ref).   -->
        <!--   Two phases: OFFLINE (expensive, one-time) and       -->
        <!--   ONLINE (cheap, per-clip).                           -->
        <!-- =================================================== -->

        <!-- ============== TITLE ============================== -->
        <mxCell id="title" value="Training Framework: Composite WER-Aware Loss and Asymmetric Two-Phase Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="1000" height="30" as="geometry" />
