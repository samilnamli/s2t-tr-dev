        </mxCell>
        <mxCell id="loss_title" value="🎯  &lt;b&gt;Composite WER-Aware Loss&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#404040;font-style:italic;&quot;&gt;three lenses on the same WER vector W&lt;sub&gt;n&lt;/sub&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1180" y="130" width="450" height="40" as="geometry" />
        </mxCell>

        <!-- L_wer -->
        <mxCell id="lwer_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5B2C6F;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1190" y="180" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lwer_h" value="&lt;b&gt;ℒ&lt;sub&gt;wer&lt;/sub&gt;&lt;/b&gt; — weighted-WER (regression-style)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;fontColor=#4A235A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="184" width="410" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lwer_eq" value="ℒ&lt;sub&gt;wer&lt;/sub&gt; = ⟨ w&lt;sub&gt;n&lt;/sub&gt; , W&lt;sub&gt;n&lt;/sub&gt; ⟩  =  Σ&lt;sub&gt;k&lt;/sub&gt; w&lt;sub&gt;n,k&lt;/sub&gt; · WER&lt;sub&gt;n,k&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1200" y="208" width="410" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lwer_pro" value="✓ aligned with task metric · directly minimizes expected WER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontColor=#1E6E2A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="234" width="410" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lwer_con" value="✗ weak gradient when WERs are similar in magnitude" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontColor=#922B21;" vertex="1" parent="1">
          <mxGeometry x="1200" y="252" width="410" height="16" as="geometry" />
        </mxCell>
        <!-- mini visualization: dot product cartoon -->
        <mxCell id="lwer_viz" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B2C6F;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="272" width="410" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lwer_viz_t" value="&lt;span style=&quot;color:#1F4E79;&quot;&gt;w&lt;sub&gt;n&lt;/sub&gt;: [.18, .67, .15]&lt;/span&gt;   ·   &lt;span style=&quot;color:#C00000;&quot;&gt;W&lt;sub&gt;n&lt;/sub&gt;: [.18, .07, .13]&lt;/span&gt;   ⇒   .098" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1200" y="272" width="410" height="22" as="geometry" />
        </mxCell>

        <!-- L_hard -->
        <mxCell id="lhard_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5B2C6F;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1190" y="310" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lhard_h" value="&lt;b&gt;ℒ&lt;sub&gt;hard&lt;/sub&gt;&lt;/b&gt; — oracle cross-entropy with label-smoothing" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;fontColor=#4A235A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="314" width="410" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lhard_eq" value="q&lt;sub&gt;hard&lt;/sub&gt; = (1−ε)·𝟙[k=k*] + ε/K ,   k* = argmin&lt;sub&gt;k&lt;/sub&gt; W&lt;sub&gt;n&lt;/sub&gt; &amp;nbsp;&amp;nbsp;⟹&amp;nbsp;&amp;nbsp; ℒ&lt;sub&gt;hard&lt;/sub&gt; = CE(w&lt;sub&gt;n&lt;/sub&gt;, q&lt;sub&gt;hard&lt;/sub&gt;)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1200" y="338" width="410" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lhard_pro" value="✓ strong gradient even when WER gaps are small" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontColor=#1E6E2A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="364" width="410" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lhard_con" value="✗ ignores how much better the oracle is than the runner-up" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Times New Roman;fontColor=#922B21;" vertex="1" parent="1">
          <mxGeometry x="1200" y="382" width="410" height="16" as="geometry" />
        </mxCell>
        <!-- mini one-hot bar chart -->
