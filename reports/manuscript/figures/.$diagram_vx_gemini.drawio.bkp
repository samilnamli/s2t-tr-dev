        <!-- ========== Stage 1 (Main Contribution) ========== -->
        <mxCell id="stage1" value="&lt;b&gt;Stage 1 — Per-Expert Temporal Encoder&lt;/b&gt;&lt;br&gt;Per-encoder linear projection W&lt;sub&gt;p&lt;/sub&gt;&lt;sup&gt;(k)&lt;/sup&gt;: ℝ&lt;sup&gt;D&lt;sub&gt;k&lt;/sub&gt;&lt;/sup&gt; → ℝ&lt;sup&gt;d&lt;/sup&gt; · sinusoidal positional encoding · model-identity embedding e&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;Shared-weight Transformer encoder applied independently to each expert&#39;s projected sequence; output of the prepended CLS token serves as the per-expert summary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#004085;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1">
